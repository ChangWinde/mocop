{
  "ssh_config": "~/.ssh/config",
  "auto_discover": false,
  "hosts": [],
  "exclude_hosts": [],
  "local_host": null,
  "expected_gpu_counts": {},
  "host_overrides": {},
  "maintenance_windows": {},
  "poll_interval_seconds": 5,
  "probe_timeout_seconds": 12,
  "connect_timeout_seconds": 5,
  "max_output_bytes": 2097152,
  "max_workers": 8,
  "listen_host": "127.0.0.1",
  "listen_port": 8787,
  "history_points": 720,
  "incident_history_points": 500,
  "collection_stale_cycles": 3,
  "incidents": {
    "resource_open_cycles": 2,
    "recovery_cycles": 2,
    "gpu_idle_memory_cycles": 12
  },
  "thresholds": {
    "cpu_warning_pct": 85,
    "memory_warning_pct": 90,
    "swap_warning_pct": 50,
    "disk_warning_pct": 85,
    "gpu_temperature_warning_c": 80,
    "gpu_busy_pct": 10,
    "gpu_memory_warning_pct": 90,
    "gpu_idle_memory_pct": 20
  }
}
