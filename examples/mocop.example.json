{
  "ssh_config": "~/.ssh/config",
  "auto_discover": false,
  "ssh_discovery": {
    "mode": "topology",
    "refresh_seconds": 300,
    "resolve_timeout_seconds": 3
  },
  "hosts": [
    "monitor-host",
    "gpu-node-01",
    "gpu-node-02"
  ],
  "exclude_hosts": [
    "gpu-gateway"
  ],
  "local_host": "monitor-host",
  "expected_gpu_counts": {
    "gpu-node-01": 8,
    "gpu-node-02": 8
  },
  "host_overrides": {},
  "maintenance_windows": {},
  "host_groups": {
    "gpu-node-01": "training",
    "gpu-node-02": "inference"
  },
  "topology": {
    "root": "monitor-host",
    "links": [
      {
        "source": "monitor-host",
        "target": "gpu-gateway",
        "transport": "frp-stcp",
        "label": "STCP · 7005"
      },
      {
        "source": "gpu-gateway",
        "target": "gpu-node-01",
        "transport": "ssh"
      },
      {
        "source": "gpu-gateway",
        "target": "gpu-node-02",
        "transport": "ssh"
      }
    ]
  },
  "poll_interval_seconds": 5,
  "gpu_process_poll_interval_seconds": 15,
  "probe_timeout_seconds": 12,
  "connect_timeout_seconds": 5,
  "retry_jitter_pct": 15,
  "manual_probe_cooldown_seconds": 5,
  "max_output_bytes": 2097152,
  "max_workers": 8,
  "listen_host": "127.0.0.1",
  "listen_port": 8787,
  "trusted_web_hosts": [],
  "history_points": 720,
  "incident_history_points": 500,
  "collection_stale_cycles": 3,
  "persistence": {
    "enabled": false,
    "retention_hours": 168,
    "max_bytes": 134217728
  },
  "workloads": {
    "mode": "disabled"
  },
  "webhooks": [],
  "incident_actions": [],
  "incident_overrides": {
    "hosts": {
      "gpu-node-02": {
        "thresholds": {
          "swap_warning_pct": 75
        },
        "exclude_disk_mounts": [
          "/mnt/archive"
        ]
      }
    }
  },
  "incidents": {
    "resource_open_cycles": 2,
    "recovery_cycles": 2,
    "gpu_idle_memory_cycles": 12
  },
  "thresholds": {
    "cpu_warning_pct": 85,
    "memory_warning_pct": 90,
    "swap_warning_pct": 50,
    "disk_warning_pct": 85,
    "disk_min_free_gib": 5,
    "psi_memory_some_pct": 20,
    "psi_io_some_pct": 30,
    "gpu_temperature_warning_c": 80,
    "gpu_busy_pct": 10,
    "gpu_memory_warning_pct": 90,
    "gpu_idle_memory_pct": 20
  }
}
